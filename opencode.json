{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "permissions": [
    { "action": "read", "resource": "*", "effect": "allow" },
    { "action": "read", "resource": ".env", "effect": "ask" },
    { "action": "read", "resource": ".env.production", "effect": "ask" },
    { "action": "read", "resource": "*secret*", "effect": "ask" },
    { "action": "read", "resource": "*password*", "effect": "ask" },
    { "action": "read", "resource": "*credential*", "effect": "ask" },
    { "action": "read", "resource": "*key*", "effect": "ask" },
    { "action": "read", "resource": "*token*", "effect": "ask" },
    { "action": "read", "resource": "*auth*", "effect": "ask" },
    { "action": "edit", "resource": "*", "effect": "allow" },
    { "action": "edit", "resource": ".env", "effect": "ask" },
    { "action": "edit", "resource": ".env.local", "effect": "allow" },
    { "action": "edit", "resource": ".env.development", "effect": "allow" },
    { "action": "edit", "resource": ".env.example", "effect": "allow" },
    { "action": "edit", "resource": ".env.production", "effect": "ask" },
    { "action": "edit", "resource": ".env.staging", "effect": "ask" },
    { "action": "edit", "resource": "*secret*", "effect": "ask" },
    { "action": "edit", "resource": "*password*", "effect": "ask" },
    { "action": "edit", "resource": "*credential*", "effect": "ask" },
    { "action": "edit", "resource": "*key*", "effect": "ask" },
    { "action": "edit", "resource": "*token*", "effect": "ask" },
    { "action": "edit", "resource": "*auth*", "effect": "ask" },
    { "action": "edit", "resource": "*.pem", "effect": "ask" },
    { "action": "edit", "resource": ".ssh/**", "effect": "ask" },
    { "action": "edit", "resource": ".aws/**", "effect": "ask" },
    { "action": "edit", "resource": "node_modules/**", "effect": "ask" },
    { "action": "edit", "resource": ".next/**", "effect": "ask" },
    { "action": "edit", "resource": "dist/**", "effect": "ask" },
    { "action": "edit", "resource": "coverage/**", "effect": "ask" },
    { "action": "edit", "resource": "package-lock.json", "effect": "ask" },
    { "action": "edit", "resource": "yarn.lock", "effect": "ask" },
    { "action": "edit", "resource": "pnpm-lock.yaml", "effect": "ask" },
    { "action": "shell", "resource": "*", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git add *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "cat *", "effect": "allow" },
    { "action": "shell", "resource": "pwd *", "effect": "allow" },
    { "action": "shell", "resource": "echo *", "effect": "allow" },
    { "action": "shell", "resource": "cd *", "effect": "allow" },
    { "action": "shell", "resource": "cp *", "effect": "allow" },
    { "action": "shell", "resource": "mv *", "effect": "allow" },
    { "action": "shell", "resource": "mkdir *", "effect": "allow" },
    { "action": "shell", "resource": "kill *", "effect": "allow" },
    { "action": "shell", "resource": "chmod *", "effect": "ask" },
    { "action": "shell", "resource": "docker *", "effect": "ask" },
    { "action": "shell", "resource": "npm run dev *", "effect": "allow" },
    { "action": "shell", "resource": "npm run build *", "effect": "allow" },
    { "action": "shell", "resource": "npm run lint *", "effect": "allow" },
    { "action": "shell", "resource": "npm run typecheck *", "effect": "allow" },
    { "action": "shell", "resource": "npm test *", "effect": "allow" },
    { "action": "shell", "resource": "curl *", "effect": "allow" },
    { "action": "shell", "resource": "rm -rf *", "effect": "ask" },
    { "action": "shell", "resource": "rm -r *", "effect": "ask" },
    { "action": "shell", "resource": "sudo *", "effect": "ask" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    { "action": "execute", "resource": "*", "effect": "allow" }
  ],
  "agents": {
    "plan": {
      "permissions": [
        { "action": "edit", "resource": "*", "effect": "ask" },
        { "action": "edit", "resource": ".agents/plans/**", "effect": "allow" }
      ]
    }
  },
  "command": {
    "goal": {
      "description": "Set a session-scoped goal and auto-continue until complete.",
      "template": "$ARGUMENTS",
      "agent": "build"
    }
  },
  "mcp": {
    "context7": {
      "type": "remote",
      "url": "https://mcp.context7.com/mcp",
      "enabled": true
    },
    "gh_grep": {
      "type": "remote",
      "url": "https://mcp.grep.app",
      "enabled": true
    },
    "obsidian": {
      "type": "local",
      "command": ["uvx", "--with", "fastmcp==2.13.3", "obsidian-mcp"],
      "environment": {
        "OBSIDIAN_VAULT_PATH": "/Users/boss123/obsidian-vault"
      },
      "enabled": true
    },
    "chrome-devtools": {
      "type": "local",
      "command": ["npx", "-y", "chrome-devtools-mcp@latest", "--autoConnect"],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": ["npx", "-y", "@playwright/mcp@latest"],
      "enabled": true
    },
    "sequential-thinking": {
      "type": "local",
      "command": ["npx", "-y", "@modelcontextprotocol/server-sequential-thinking"],
      "enabled": true
    }
  }
}
